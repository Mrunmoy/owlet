# owlet ESP32-S3 defaults. `idf.py menuconfig` overrides take precedence.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The USB-C port (USB-Serial-JTAG) is the protocol link. Logs go to UART0
# (TX = GP43) so they never interleave with protocol frames.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# C++ exceptions / RTTI disabled - matches project-wide rule.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# 1 kHz tick so the 10 ms control loop period is exact.
CONFIG_FREERTOS_HZ=1000

# Keep the brown-out detector on: a servo stall on a shared 5 V rail should
# show up as a visible reset, not a mystery.
CONFIG_ESP_BROWNOUT_DET=y
