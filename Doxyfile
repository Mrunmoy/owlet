# API reference for owlet's firmware libraries.  Build with: ./build.py --docs
PROJECT_NAME           = owlet
PROJECT_BRIEF          = "Pan-tilt head firmware: motor-neutral core, pluggable drivers, platforms and protocols"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = drivers firmware/common platform
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */managed_components/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
